/* Dialogo Principal */
#AdjustBalanceDialog {
    background-color: white;
    border-radius: 8px;
}

/* Etiquetas */
#FormLabel {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 4px;
}

/* Inputs (Monto y Motivo) */
#InputField {
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
    background-color: #f9f9f9;
}
#InputField:focus {
    border: 1px solid %(PRIMARY_COLOR)s;
    background-color: white;
}

/* Botones de Seleccion de Tipo: estilo "modeButton" ahora en shared.qss,
   compartido con otros diálogos de ajuste (ver EditAdminDialog). */

/* Contador de caracteres */
#CharCounter {
    font-size: 11px;
    color: #888;
    margin-top: 2px;
}
#CharCounter[limitReached="true"] {
    color: #dc3545;
    font-weight: bold;
}

/* Boton Guardar */
#ActionSaveButton {
    background-color: %(PRIMARY_COLOR)s;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
}
#ActionSaveButton:hover {
    background-color: #0f2b4d;
}
#ActionSaveButton:disabled {
    background-color: #ccc;
}