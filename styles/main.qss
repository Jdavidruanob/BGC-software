/* ============================================================
   Barra de navegación superior — estética moderna
   ============================================================ */

/* Lienzo general (se mantiene claro para no afectar labels sobre tarjetas) */
QWidget {
    background: #ffffff;
}

/* Barra superior */
QWidget#TopBar {
    background-color: %(PRIMARY_COLOR)s;
    border-bottom: 3px solid #12294a;
}

/* Botones de navegación: transparentes sobre el azul, tipo "pill" */
QPushButton#NavBarButton {
    color: #94a3b8;
    background-color: transparent;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 16px;
    border: none;
    border-radius: 12px;
    margin-left: 8px;
}

QPushButton#NavBarButton:hover {
    background-color: %(PRIMARY_HOVER_COLOR)s;
    color: #ffffff;
}

/* Botón activo (pastilla blanca con texto azul) */
QPushButton#NavBarButton[active="true"] {
    background-color: #ffffff;
    color: %(PRIMARY_COLOR)s;
    font-weight: 800;
}
