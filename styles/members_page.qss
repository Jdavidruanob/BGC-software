/* ============================================================
   POS de Socios — estética moderna
   ============================================================ */

QWidget#membersPageRoot {
    background: #f4f6fb;
}

/* --- Título de la sección --- */
#title-members {
    font-size: 26px;
    font-weight: 800;
    color: %(PRIMARY_COLOR)s;
}
#subtitle-members {
    font-size: 14px;
    color: #6b7280;
}

/* --- Botón principal "Nuevo Socio" --- */
#newMemberButton {
    background-color: %(PRIMARY_COLOR)s;
    color: white;
    border: none;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 15px;
    border-radius: 10px;
    min-height: 40px;
}
#newMemberButton:hover {
    background-color: %(PRIMARY_HOVER_COLOR)s;
}

/* --- Botón secundario "Crédito manual" (contorno) --- */
#posSecondaryButton {
    background-color: #ffffff;
    color: %(PRIMARY_COLOR)s;
    border: 1.5px solid #cbd5e1;
    padding: 8px 18px;
    font-weight: bold;
    font-size: 15px;
    border-radius: 10px;
    min-height: 40px;
}
#posSecondaryButton:hover {
    background-color: #eef2f7;
    border-color: %(PRIMARY_COLOR)s;
}

/* --- Barra de búsqueda --- */
#searchBox-members {
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding-left: 10px;
    min-height: 40px;
    font-size: 15px;
    background: #ffffff;
    selection-background-color: %(PRIMARY_COLOR)s;
}
#searchBox-members:focus {
    border: 1.5px solid %(PRIMARY_COLOR)s;
    background: #ffffff;
}

/* ============================================================
   Tabla POS
   ============================================================ */
QTableWidget#membersTable {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    gridline-color: transparent;
    outline: none;
    font-size: 15px;
    color: #1f2937;
    alternate-background-color: #fbfcfe;
    padding: 4px;
}

QTableWidget#membersTable::item {
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #eef1f6;
}

QTableWidget#membersTable::item:hover {
    background: #f1f5f9;
}

QTableWidget#membersTable::item:selected {
    background: #e8eef6;
    color: #0f2b4a;
}

/* Encabezado de la tabla */
QTableWidget#membersTable QHeaderView::section {
    background: #f8fafc;
    color: #475569;
    font-weight: bold;
    font-size: 13px;
    padding: 12px 10px;
    border: none;
    border-bottom: 2px solid #e5e7eb;
}
QTableWidget#membersTable QHeaderView::section:first {
    border-top-left-radius: 14px;
}
QTableWidget#membersTable QHeaderView::section:last {
    border-top-right-radius: 14px;
}

/* Scrollbar sutil */
QTableWidget#membersTable QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}
QTableWidget#membersTable QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 30px;
}
QTableWidget#membersTable QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QTableWidget#membersTable QScrollBar::add-line:vertical,
QTableWidget#membersTable QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ============================================================
   Botones de acción por fila (ver / editar / eliminar)
   ============================================================ */
#posVerButton, #posEditButton, #posDeleteButton {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}
#posVerButton:hover {
    background: #e0e7f1;
    border-color: %(PRIMARY_COLOR)s;
}
#posEditButton:hover {
    background: #e0e7f1;
    border-color: %(PRIMARY_COLOR)s;
}
#posDeleteButton:hover {
    background: #fee2e2;
    border-color: #ef4444;
}
