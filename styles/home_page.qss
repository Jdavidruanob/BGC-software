

QFrame#HomeCard {
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: #ffffff;
}

QFrame#HomeCardHeader {
    background-color: %(PRIMARY_COLOR)s;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}

QLabel#homeTitle {
    background-color: %(PRIMARY_COLOR)s;
    font-size: 32px;
    margin-bottom: 10px;
    font-weight: bold;
    color: white;
}

QLabel#homeSubtitle {
    background-color: %(PRIMARY_COLOR)s;
    font-size: 16px;
    color: white;
    margin-left: 10px;
}



/* Botones seleccionables */
QPushButton[btnType="operacion"] {
    background-color: #f4f7fb;
    color: #64748b;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 600;
    padding: 12px 20px;
    margin: 0 4px;
}

QPushButton[btnType="operacion"]:hover {
    border: 1.5px solid %(PRIMARY_COLOR)s;
    color: %(PRIMARY_COLOR)s;
}

QPushButton[btnType="operacion"]:checked {
    background-color: %(PRIMARY_COLOR)s;
    color: white;
    border: 1.5px solid %(PRIMARY_COLOR)s;
    font-weight: bold;
}

#summaryCard {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background-color: #FFF;
}

/* Header azul claro */
#summaryHeader {
    background-color: #F1F5F9;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid #e5e7eb;
}

#summaryTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1E293B;
    background-color: transparent;
}

/* Scrollbar fino del área "Al día de hoy" */
#notifScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
#notifScroll QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 24px;
}
#notifScroll QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
#notifScroll QScrollBar::add-line:vertical,
#notifScroll QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Labels de valor */
#summaryValue {
    font-size: 14px;
    color: #334155;
}

#summaryValueBold {
    font-size: 14px;
    font-weight: 600;
    color: #1E293B;
}

QPushButton#btnEditarSaldo {
    background: #fff;
    color: #3b82f6;
    border: 1px solid #3b82f6;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 500;
    padding: 10px 0;
    text-align: center;
    margin-bottom: 0px;
}

QPushButton#btnEditarSaldo:hover {
    background: #f1f5f9;
}

QPushButton#btnEditarSaldo, QPushButton#btnEditarAdmin {
    background: #fff;
    color: #3b82f6; /* Azul primario */
    border: 1px solid #3b82f6;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 500;
    padding: 10px 0;
    text-align: center;
    margin-bottom: 0px;
}

QPushButton#btnEditarSaldo:hover, QPushButton#btnEditarAdmin:hover {
    background: #f1f5f9;
}

QPushButton#btnCambiarBD {
    background: #fff;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 500;
    padding: 10px 0;
    text-align: center;
}

QPushButton#btnCambiarBD:hover {
    background: #f9fafb;
    border: 2px solid #e4eaf1;
}


#createReceipt {
  font-size: 16px;
  padding: 8px 20px;
  background-color: %(PRIMARY_COLOR)s;
  color: white;
  border-radius: 6px;
  font-weight: bold;
}
#createReceipt:hover {
  background-color: %(PRIMARY_HOVER_COLOR)s;
}

#confirmDate {
    font-size: 16px;
    padding: 8px 10px;
    background-color: %(PRIMARY_COLOR)s;
    color: white;
    border-radius: 4px;
    font-weight: bold;
    border: transparent;
}
#confirmDate:hover {
    background-color: %(PRIMARY_HOVER_COLOR)s;
    border: 2px solid %(PRIMARY_HOVER_COLOR)s;
}