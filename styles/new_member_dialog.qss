#NewMemberDialog, #ManualCreditDialog {
    background-color: #fefefe;
    font-family: "Inter", sans-serif;
    font-size: 20px;
    color: %(TEXT_COLOR)s;
    border-radius: 12px;
}

#FormLabel {
    font-weight: bold;
    font-size: 18px;
    color: %(PRIMARY_COLOR)s;
}

/* Campos de texto, fecha y combo: misma altura cómoda y padding para que el
   texto no se vea cortado ni apretado. */
#InputField, #ManualCreditDialog QDateEdit, #ManualCreditDialog QComboBox {
    min-height: 42px;
    font-size: 18px;
    padding: 6px 12px;
    border: 2px solid #e4eaf1;
    border-radius: 8px;
    background-color: #ffffff;
    color: %(TEXT_COLOR)s;
}
#InputField:focus, #ManualCreditDialog QDateEdit:focus, #ManualCreditDialog QComboBox:focus {
    border: 2px solid %(PRIMARY_COLOR)s;
}
#ManualCreditDialog QDateEdit::drop-down, #ManualCreditDialog QComboBox::drop-down {
    width: 28px;
    border: none;
}
#HelpText {
    font-size: 14px;
    color: #64748b;
}

#PhotoButton {
    font-size: 16px;
    padding: 8px 12px;
    background-color: %(PRIMARY_COLOR)s;
    color: white;
    border: none;
    border-radius: 6px;
}

#PhotoButton:hover{
    background-color: %(PRIMARY_HOVER_COLOR)s;
}

#CreateMemberButton {
    font-size: 16px;
    padding: 10px 30px;
    font-weight: bold;
    background-color: %(PRIMARY_COLOR)s;
    color: white;
    border-radius: 8px;
}
#CreateMemberButton:hover {
    background-color: %(PRIMARY_HOVER_COLOR)s;
}