# Copia este archivo como .env y completa los valores reales.
# La contraseña real la entrega el dueño por canal privado.
# NUNCA subas el archivo .env al repositorio (está en .gitignore).

# --- Entorno --------------------------------------------------------------
# produccion = base real (la app se ve normal)
# pruebas    = base de copia (la app muestra una franja ámbar de aviso)
#
# Es la fuente de verdad. Si se deja vacía, el entorno se deduce del puerto de
# DATABASE_URL y, si no se reconoce, se asume produccion por prudencia.
APP_ENV=produccion

# --- Base de datos --------------------------------------------------------
# Deja activa SOLO una de las dos líneas, y que APP_ENV coincida con ella.

# Producción (puerto 42792)
DATABASE_URL=postgresql://postgres:<password>@sakura.proxy.rlwy.net:42792/railway

# Pruebas (puerto 54722)
# DATABASE_URL=postgresql://postgres:<password>@sakura.proxy.rlwy.net:54722/railway
